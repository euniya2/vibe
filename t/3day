<script>
/* ---------- 하위페이지 전환 ---------- */
const pages = [...document.querySelectorAll('.page')];
function show(id) {
  if (!id) { try { id = location.hash.slice(1); } catch (e) {} }
  const el = id && document.getElementById(id);
  const target = el && el.classList.contains('page') ? id : 'start';
  pages.forEach(p => p.classList.toggle('on', p.id === target));
  document.querySelectorAll('#menu a').forEach(a => a.classList.toggle('on', a.getAttribute('href') === '#' + target));
  try { history.replaceState(null, '', '#' + target); } catch (e) {}
  if (target === 'log') { try { renderLog(); } catch (e) {} }
  window.scrollTo(0, 0);
}
// 메뉴·다음 버튼·안내 링크: 주소 이동 없이 바로 해당 화면으로
document.addEventListener('click', e => {
  const a = e.target.closest('a[href^="#"]');
  if (!a) return;
  e.preventDefault();
  show(a.getAttribute('href').slice(1));
});

/* ---------- 복사 ---------- */
function copyText(text, btn) {
  const done = () => { btn.textContent = '복사됨'; btn.classList.add('done');
    setTimeout(() => { btn.textContent = btn.dataset.label || '복사'; btn.classList.remove('done'); }, 1500); };
  if (navigator.clipboard && window.isSecureContext) navigator.clipboard.writeText(text).then(done, fallback); else fallback();
  function fallback() {
    const t = document.createElement('textarea'); t.value = text; document.body.appendChild(t); t.select();
    try { document.execCommand('copy'); done(); } catch (e) { alert('복사하지 못했습니다. 직접 선택해 복사해 주세요.'); }
    t.remove();
  }
}
// [예시 보기] 버튼 글자는 복사에서 뺌
function promptText(pre) {
  const c = pre.cloneNode(true);
  c.querySelectorAll('.peek').forEach(x => x.remove());
  return c.textContent;
}
document.querySelectorAll('.box .copy').forEach(b => b.addEventListener('click', () => copyText(promptText(b.parentElement.querySelector('pre')), b)));

/* ---------- 예시 보기 (화면 위에 겹쳐 뜸) ---------- */
function closeModals() { document.querySelectorAll('.modal').forEach(m => { m.hidden = true; }); }
document.addEventListener('click', e => {
  const opener = e.target.closest('[data-open]');
  if (opener) { document.getElementById(opener.dataset.open).hidden = false; return; }
  if (e.target.closest('.closex') || e.target.classList.contains('modal')) closeModals();
});
document.addEventListener('keydown', e => { if (e.key === 'Escape') closeModals(); });
const dataBtn = document.getElementById('copyData');
dataBtn.dataset.label = dataBtn.textContent;
dataBtn.addEventListener('click', () => copyText(document.getElementById('dataMD').innerText, dataBtn));

// 상품본부 데이터를 CSV 파일로 내려받기 (엑셀에서도 한글이 깨지지 않게 UTF-8 BOM)
document.getElementById('csvData').addEventListener('click', e => {
  const text = document.getElementById('dataMD').textContent.trim().replace(/\r?\n/g, '\r\n') + '\r\n';
  const url = URL.createObjectURL(new Blob(['﻿' + text], { type: 'text/csv;charset=utf-8' }));
  const a = document.createElement('a'); a.href = url; a.download = '상품본부_데이터.csv';
  document.body.appendChild(a); a.click(); a.remove(); setTimeout(() => URL.revokeObjectURL(url), 1000);
  const b = e.currentTarget; b.textContent = '내려받음'; b.classList.add('done');
  setTimeout(() => { b.textContent = '상품본부 CSV 내려받기'; b.classList.remove('done'); }, 1500);
});

/* ---------- 숫자 후보: 고르면 3단계 프롬프트에 계산식이 들어감 ---------- */
const CANDS = [
  ['판로지원액 달성률', '계획대로 가고 있는가', '실적 합계 ÷ 목표 합계 × 100'],
  ['전년 대비', '작년보다 나아졌는가', '(실적 합계 ÷ 전년실적 합계 − 1) × 100'],
  ['공헌이익 달성률', '팔고 남긴 것도 지켰는가', '공헌이익실적 합계 ÷ 공헌이익목표 합계 × 100'],
  ['목표 미달 팀 수', '누구와 이야기해야 하는가', '달성률(실적 ÷ 목표 × 100)이 95% 미만인 팀 수'],
  ['공헌이익 미달 팀 수', '어디서 이익을 점검해야 하는가', '공헌이익 달성률(공헌이익실적 ÷ 공헌이익목표 × 100)이 100% 미만인 팀 수'],
  ['가장 낮은 팀의 달성률', '가장 급한 곳은 어디인가', '팀별 달성률 중 가장 낮은 값과 그 팀 이름']
];
const picksBox = document.getElementById('picks');
if (picksBox) picksBox.innerHTML = CANDS.map(([n, q, f], i) =>
  `<label class="pick"><input type="checkbox" data-pick="${i}"><b>${n}</b><span class="q">${q}</span><span class="f">${f}</span></label>`).join('');
const boxes = picksBox ? [...picksBox.querySelectorAll('input')] : [];
function updatePicks() {
  if (!picksBox) return;
  const on = boxes.filter(b => b.checked);
  boxes.forEach(b => { b.disabled = !b.checked && on.length >= 3; b.parentElement.classList.toggle('on', b.checked); b.parentElement.classList.toggle('off', b.disabled); });
  document.getElementById('pickCount').textContent = on.length + ' / 3';
  const lines = on.map(b => { const [n, , f] = CANDS[+b.dataset.pick]; return `- ${n}: ${f}`; });
  document.getElementById('pickLines').textContent = lines.length ? lines.join('\n') : '(1단계에서 고른 숫자 3개가 여기에 들어갑니다)';
  document.getElementById('pickWarn').hidden = on.length === 3;
  renderReasons(on.map(b => +b.dataset.pick));
}
// 고른 숫자마다 이유를 적는 한 줄 칸. 체크를 풀면 그 줄도 사라짐
const reasonVals = {};
function renderReasons(ids) {
  const box = document.getElementById('reasons');
  Object.keys(reasonVals).forEach(k => { if (!ids.includes(+k)) delete reasonVals[k]; });
  if (!ids.length) { box.innerHTML = '<div class="empty">위에서 숫자를 고르면 이유를 적는 칸이 생깁니다.</div>'; return; }
  box.innerHTML = ids.map((i, n) =>
    `<div class="rrow"><span class="rname">${CANDS[i][0]}</span><input type="text" data-reason="${i}" placeholder="${n === 0 ? '예) 계획에서 벗어나면 어느 팀에서 빠졌는지 확인한다' : '목표에서 벗어나면 나는 무엇을 하는가?'}"></div>`).join('');
  box.querySelectorAll('input').forEach(inp => {
    inp.value = reasonVals[inp.dataset.reason] || '';
    inp.addEventListener('input', () => { reasonVals[inp.dataset.reason] = inp.value; save(); });
  });
}
const reasonText = () => Object.keys(reasonVals).filter(k => reasonVals[k].trim()).map(k => `${CANDS[k][0]} — ${reasonVals[k].trim()}`).join('\n');
boxes.forEach(b => b.addEventListener('change', () => { updatePicks(); save(); }));

/* ---------- 브라우저 임시 저장 (이 PC에만) ---------- */
// 3일차·4일차 페이지가 같은 키를 씀: 4일차에서 어제 적은 답을 읽을 수 있음
const KEY = 'mc2612-day34';
const IDS = ['judge1', 'judge2', 'who', 'known', 'myjudge', 'pickq', 'msg', 'mine'];
const fields = () => IDS.map(id => document.getElementById(id)).filter(Boolean);
function stored() {
  try { return JSON.parse(localStorage.getItem(KEY) || '{}'); } catch (e) { return {}; }
}
// 이 페이지에 있는 칸만 덮어쓰고, 다른 날 페이지에서 적은 값은 그대로 둠
function save() {
  const v = stored();
  // 숫자 체크는 새로 열면 비어 있음: 하나도 체크하지 않았으면 저장해 둔 값을 그대로 둠
  if (picksBox && boxes.some(b => b.checked)) {
    v.picks = boxes.filter(b => b.checked).map(b => CANDS[+b.dataset.pick][0]);
    v.reasons = reasonText();
  }
  fields().forEach(el => { v[el.id] = el.value; });
  try { localStorage.setItem(KEY, JSON.stringify(v)); } catch (e) {}
}
function load() {
  const v = stored();
  fields().forEach(el => { if (v[el.id] != null) el.value = v[el.id]; });
  // 숫자 체크는 되살리지 않음: 페이지를 새로 열면 빈 상태에서 다시 고름
}
fields().forEach(el => el.addEventListener('input', save));
load(); updatePicks(); show();

/* ---------- 8단계 상황 카드: 고르면 프롬프트가 완성됨 ---------- */
// [상황, 생각할 점, 흐린 예시 판단]
const SITS = [
  ['판로지원액 목표는 넘겼는데 공헌이익은 크게 못 미친 팀이 있다.', '잘한 팀인가, 남는 것 없이 판 실적인가', '예) 목표를 넘겼으니 이번에는 문제 삼지 않으려 한다'],
  ['목표에 크게 못 미쳤고 작년보다도 줄어든 팀이 있다. 이유는 보고받았다.', '이유를 아는 것으로 충분한가', '예) 이유를 보고받았으니 다음 분기까지 지켜보려 한다'],
  ['목표에 조금 못 미쳤는데 공헌이익도 기준 아래인 팀이 있다. 이유는 아직 모른다.', '눈에 덜 띄지만 놓치기 쉬운 팀', '예) 차이가 크지 않으니 이번 회의에서는 다루지 않으려 한다'],
  ['전체 달성률은 목표에 가까운데, 팀 사이 차이가 크다.', '전체 숫자가 가리는 것은 무엇인가', '예) 본부 전체가 목표에 가까우니 큰 문제는 없다고 보려 한다']
];
const sitsBox = document.getElementById('sits');
if (sitsBox) sitsBox.innerHTML = SITS.map(([s, q], i) =>
  `<label class="pick"><input type="radio" name="sit" value="${i}"><b>${s}</b><span class="q">${q}</span></label>`).join('');
const sitRadios = sitsBox ? [...sitsBox.querySelectorAll('input')] : [];
function updateSit() {
  if (!sitsBox) return;
  const on = sitRadios.find(r => r.checked);
  const j = document.getElementById('myjudge').value.trim();
  sitRadios.forEach(r => r.parentElement.classList.toggle('on', r.checked));
  if (on) document.getElementById('myjudge').placeholder = SITS[+on.value][2];
  // 알고 있는 사정(선택): 적으면 상황 뒤에 붙이고, 비우면 이유를 모른다고 붙임(상황 문장에 이미 '이유'가 있으면 그대로)
  const k = document.getElementById('known').value.trim().replace(/\s*\n\s*/g, ' ');
  let sit = on ? SITS[+on.value][0] : '';
  if (on) sit += k ? ` 알고 있는 사정: ${k.replace(/[.。]\s*$/, '')}.` : (sit.includes('이유') ? '' : ' 알려진 이유는 없다.');
  document.getElementById('sitLine').textContent = on ? sit : '(위에서 고른 상황이 여기에 들어갑니다)';
  document.getElementById('judgeLine').textContent = j || '(위에 적은 내 판단이 여기에 들어갑니다)';
  document.getElementById('sitWarn').hidden = !!(on && j);
}
sitRadios.forEach(r => r.addEventListener('change', updateSit));
['myjudge', 'known'].forEach(id => { const el = document.getElementById(id); if (el) el.addEventListener('input', updateSit); });
updateSit();
// 6단계: 어제(3일차 5단계) 적은 답이 이 PC에 남아 있으면 보여 줌
const yBox = document.getElementById('yesterdayBox');
if (yBox) {
  const yv = (stored().judge2 || '').trim();
  if (yv) { document.getElementById('yesterday').textContent = yv; yBox.hidden = false; }
}

// 내 기록: 3·4일차 페이지 어느 쪽에서 봐도 두 날의 기록을 모두 모음
const LOG_LABELS = [['judge1', '먼저 부를 팀(처음)'], ['judge2', '먼저 부를 팀(다시)'], ['who', '먼저 부를 팀(4일차)'], ['known', '알고 있는 사정'], ['myjudge', '내 판단'], ['pickq', '고른 질문'], ['msg', '핵심 메시지'], ['mine', '우리 팀 지표']];
function logItems() {
  save();
  // 저장소를 못 쓰는 브라우저에서도 지금 화면에 적힌 답은 들어가게 함
  const v = stored();
  fields().forEach(el => { v[el.id] = el.value; });
  if (picksBox && boxes.some(b => b.checked)) { v.picks = boxes.filter(b => b.checked).map(b => CANDS[+b.dataset.pick][0]); v.reasons = reasonText(); }
  const items = [];
  if (v.picks && v.picks.length) items.push(['고른 숫자', v.picks.join(', ')]);
  if (v.reasons) items.push(['고른 이유', v.reasons]);
  LOG_LABELS.forEach(([id, label]) => { const t = (v[id] || '').trim(); if (t) items.push([label, t]); });
  return items;
}
function escLog(t) { return String(t).replace(/[&<>"]/g, c => ({'&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;'}[c])); }
function renderLog() {
  const host = document.getElementById('logList'); if (!host) return;
  const items = logItems();
  host.innerHTML = items.length
    ? items.map(([label, t]) => '<div class="rec"><h4>' + escLog(label) + '</h4><div>' + escLog(t) + '</div></div>').join('')
    : '<p class="logempty">' + '아직 적은 답이 없습니다. 1단계(숫자 고르기)와 4·5단계 끝에서 적은 답이 여기에 모입니다.' + '</p>';
}
document.getElementById('copyLog').addEventListener('click', e => {
  const s = '[3·4일차 내 기록]\n' + logItems().map(([label, t]) => `\n[${label}]\n${t}\n`).join('');
  e.target.dataset.label = '기록 복사';
  copyText(s, e.target);
});
// 처음 열 때 '내 기록' 화면이면 바로 그림(위의 show()가 이 코드보다 먼저 실행되므로)
if (document.getElementById('log').classList.contains('on')) renderLog();
document.getElementById('clearLog').addEventListener('click', () => {
  if (!confirm('3·4일차에 적어 둔 기록을 모두 지울까요? 4일차 끝에 지우는 것을 권합니다.')) return;
  fields().forEach(el => { el.value = ''; });
  boxes.forEach(b => { b.checked = false; });
  Object.keys(reasonVals).forEach(k => delete reasonVals[k]);
  updatePicks();
  renderLog();
  try { localStorage.removeItem(KEY); } catch (e) {}
});
</script>
